# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# android (Capacitor). De map android/ zelf wordt WEL gecommit; android/.gitignore regelt de rest
# (ook de gekopieerde web-assets en de gegenereerde capacitor.config.json).
/android/app/build/
/android/build/
/android/.gradle/
/android/.idea/
/android/.kotlin/
/android/local.properties
/android/capacitor-cordova-android-plugins/build/
# Ondertekeningssleutels nooit committen (bewaar ze veilig, zonder sleutel geen updates in de Play Store).
*.jks
*.keystore
