# Te vinden in Supabase → Project Settings → API (of "Connect" bovenaan je project)
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-of-publishable-key

# AI-coach (alleen op de server, nooit NEXT_PUBLIC_ ervoor zetten)
ANTHROPIC_API_KEY=sk-ant-...
COACH_DAILY_LIMIT=40

# Pushmeldingen
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://jouw-app.vercel.app
CRON_SECRET=
# Alleen op de server, voor het versturen van meldingen naar andere leden
SUPABASE_SECRET_KEY=
